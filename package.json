{
  "name": "@solid-fluent/components",
  "version": "0.1.0",
  "packageManager": "pnpm@10.7.0",
  "description": "SolidJS rewrite of @fluentui/react-components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/solid-fluent.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "storybook": "node scripts/pin-storybook-typescript.mjs && storybook dev -p 6006",
    "build-storybook": "node scripts/pin-storybook-typescript.mjs && storybook build",
    "build": "BUILD_LIB=1 vite build --mode lib && tsc -p tsconfig.build.json",
    "build:lib": "BUILD_LIB=1 vite build --mode lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "postinstall": "node scripts/pin-storybook-typescript.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "x18n": "^2.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "^4.1.3",
    "@solidjs/testing-library": "^0.8.10",
    "@storybook/addon-docs": "^10.5.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "jsdom": "^30.0.1",
    "remark-gfm": "^4.0.1",
    "solid-js": "^1.9.14",
    "storybook": "^10.5.2",
    "storybook-solidjs-vite": "^10.6.0",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "solid",
    "solidjs",
    "fluent",
    "fluentui",
    "components",
    "ui"
  ],
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "storybook-solidjs-vite>typescript": "5.9.3"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
